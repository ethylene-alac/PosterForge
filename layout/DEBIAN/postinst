#!/bin/sh
set -e
root="/var/mobile/Library/Application Support/PosterForge"
for dir in "$root" "$root/Library" "$root/Requests" "$root/Completed"; do
    mkdir -p "$dir"
    chown mobile:mobile "$dir"
    chmod 0775 "$dir"
done
mkdir -p /var/mobile/Library/Logs
touch /var/mobile/Library/Logs/PosterForge.log
chown mobile:mobile /var/mobile/Library/Logs/PosterForge.log
chmod 0644 /var/mobile/Library/Logs/PosterForge.log
launchctl bootout system/com.posterforge.daemon 2>/dev/null || true
if ! launchctl bootstrap system /var/jb/Library/LaunchDaemons/com.posterforge.daemon.plist; then
    echo "PosterForge: launchd bootstrap failed; inspect launchctl print system/com.posterforge.daemon" >&2
fi
if ! launchctl kickstart -k system/com.posterforge.daemon; then
    echo "PosterForge: daemon did not start; inspect /var/mobile/Library/Logs/PosterForge.log" >&2
fi
echo "PosterForge: expected service domain is system/com.posterforge.daemon (ProcessType Background is a scheduling class, not a bootstrap domain)."
launchctl print system/com.posterforge.daemon 2>&1 || true
exit 0
